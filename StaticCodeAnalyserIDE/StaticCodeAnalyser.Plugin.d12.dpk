package StaticCodeAnalyser.Plugin.d12;

// ---------------------------------------------------------------------
// Pakettyp (2026-08-23): der Monolith, dieselbe Rolle.
//
// Ohne {$RUNONLY} bzw. {$DESIGNONLY} haelt die IDE ein Paket fuer
// BEIDES und installiert es nach jedem Bau in sich selbst. Genau
// daran ist Delphi 13 heute gescheitert: SCA.Engine und
// SCA.SharedUI standen aus einem IDE-Bau in den Known Packages,
// der Monolith kam per Setup daneben, und die IDE meldete
// "enthaelt die Unit 'uLocalization', die auch im Package
// 'SCA.Engine' enthalten ist".
//
// Die Angabe in der .dproj (<RuntimeOnlyPackage> bzw.
// <DesignOnlyPackage>) reicht NICHT - sie ist nur der
// MSBuild-Spiegel. Massgeblich fuer die gebaute BPL ist diese
// Direktive. So machen es auch JCL und die GetIt-Plugins.
//
// Sie gehoert aber TROTZDEM in die .dproj, und das ist am
// 2026-08-24 klar geworden: ohne sie weiss die IDE vor dem
// Compilieren nichts von der Rolle des Pakets, bietet im Project
// Manager "Install" auch fuer ein Laufzeitpaket an und meldet erst
// beim Laden "kann nicht installiert werden, da es kein
// Entwurfszeit-Package ist". Mit dem Eintrag ist der Menuepunkt
// gar nicht erst da.
{$DESIGNONLY}
// ---------------------------------------------------------------------
// Win64 gibt es fuer dieses Paket erst ab Delphi 13.
//
// Delphi 12 liefert designide NUR fuer Win32 - am 2026-08-23 erschoepfend
// gesucht: 23.0\bin\designide290.bpl und 23.0\lib\win32\{debug,release}\
// designide.dcp, sonst nichts. Der Ordner 23.0\lib\win64\release
// existiert und traegt 96 DCPs, designide ist keines davon; ToolsAPI.dcu
// fehlt dort ebenfalls. Delphi 12 hat auch keine 64-Bit-IDE, die eine
// solche BPL laden koennte (kein 23.0\bin64\bds.exe).
//
// Ohne diese Zeile meldet der Compiler "E2202 Package 'designide' wird
// benoetigt, konnte aber nicht gefunden werden" - eine Meldung, die nicht
// sagt, dass die Plattform das Problem ist.
//
// VER360 ist Delphi 12 (belegt in der Indy-Quelle der 23.0-Installation,
// IdCompilerDefines.inc: "//Delphi & CBuilder 12" ueber {$IFDEF VER360}).
// Bewusst NUR gegen VER360 geprueft, nicht gegen "alles ausser VER370":
// eine kuenftige Delphi-Version soll nicht mit abgewiesen werden.
{$IF Defined(WIN64) and Defined(VER360)}
  {$MESSAGE FATAL 'Win64 gibt es fuer dieses Paket erst ab Delphi 13 - Delphi 12 liefert kein designide fuer Win64. Unter D12 bitte Win32 bauen.'}
{$IFEND}

{$R *.res}
// Monolith-Release-Package (Installer P1 / GetIt, Konzept 2026-07-23 +
// 2026-08-14): enthaelt ALLE Units von SCA.Engine + SCA.SharedUI +
// StaticCodeAnalyserIDE in EINER BPL. Grund: der Windows-Loader loest
// `requires` ueber bds.exe-Dir/System32/PATH auf, nicht im BPL-Ordner -
// drei private BPLs in %LOCALAPPDATA% sind nicht direkt ladbar.
//
// NIE zusammen mit dem Dev-3-Package-Satz laden (dieselben Units in zwei
// Packages = E2201/Laufzeitkonflikt) - der Installer-Koexistenz-Check
// raeumt Dev-Registrierungen; auf Dev-Maschinen bleibt der 3er-Satz.
//
// Branding-Resource wie im Dev-IDE-Package (Details dort):
{$R 'sca_branding.res'}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  xmlrtl;   // Xml.XMLDoc/IXMLDocument fuer uProjectFiles

