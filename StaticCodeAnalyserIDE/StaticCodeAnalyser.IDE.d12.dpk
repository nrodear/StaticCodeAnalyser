package StaticCodeAnalyser.IDE.d12;

// ---------------------------------------------------------------------
// Pakettyp (2026-08-23): das ist das Plugin des Dev-Satzes - es gehoert in die IDE.
//
// Ohne {$RUNONLY} bzw. {$DESIGNONLY} haelt die IDE ein Paket fuer
// BEIDES und installiert es nach jedem Bau in sich selbst. Genau
// daran ist Delphi 13 heute gescheitert: SCA.Engine und
// SCA.SharedUI standen aus einem IDE-Bau in den Known Packages,
// der Monolith kam per Setup daneben, und die IDE meldete
// "enthaelt die Unit 'uLocalization', die auch im Package
// 'SCA.Engine' enthalten ist".
//
// Die Angabe in der .dproj (<RuntimeOnlyPackage> bzw.
// <DesignOnlyPackage>) reicht NICHT - sie ist nur der
// MSBuild-Spiegel. Massgeblich fuer die gebaute BPL ist diese
// Direktive. So machen es auch JCL und die GetIt-Plugins.
//
// Sie gehoert aber TROTZDEM in die .dproj, und das ist am
// 2026-08-24 klar geworden: ohne sie weiss die IDE vor dem
// Compilieren nichts von der Rolle des Pakets, bietet im Project
// Manager "Install" auch fuer ein Laufzeitpaket an und meldet erst
// beim Laden "kann nicht installiert werden, da es kein
// Entwurfszeit-Package ist". Mit dem Eintrag ist der Menuepunkt
// gar nicht erst da.
{$DESIGNONLY}
{$R *.res}
// Branding-Resource (sca.png als RCDATA fuer Splash + About-Box):
//   * <RcCompile Include="..\branding\sca_branding.rc"/> im .dproj triggert
//     BRCC32. RBCC32 legt das Output NEBEN die dproj/dpk (nicht neben die
//     .rc!) -> StaticCodeAnalyserIDE\sca_branding.res.
//   * {$R 'sca_branding.res'} hier linkt die .res in die BPL (sonst sieht
//     der Linker das BRCC32-Output zwar liegen, ignoriert es aber - waere
//     genau das Symptom 'IDE-Plugin-Icon nirgends sichtbar').
// WICHTIG: .RES Extension (NICHT .RC). {$R '...rc'} wuerde den 16-bit-
// Legacy-BRC ankicken (E2161 Unsupported 16bit resource).
// PFAD: relativ zur dpk (gleiches Verzeichnis), NICHT relativ zur .rc!
{$R 'sca_branding.res'}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  SCA.Engine,
  SCA.SharedUI;

contains
  uIDEExpert in 'uIDEExpert.pas',
  uIDEAnalyserForm in 'uIDEAnalyserForm.pas',
  uIDEFindingsPropertiesForm in 'uIDEFindingsPropertiesForm.pas',
  uIDELineHighlighter in 'uIDELineHighlighter.pas',
  uIDEAnnotationOverlay in 'uIDEAnnotationOverlay.pas',
  uIDEMessages in 'uIDEMessages.pas',
  uIDEWatchMode in 'uIDEWatchMode.pas',
  uIDEEditorIntegration in 'uIDEEditorIntegration.pas',
  uIDEStatusBar in 'uIDEStatusBar.pas',
  uIDETheme in 'uIDETheme.pas',
  uIDEAnalyseProgress in 'uIDEAnalyseProgress.pas',
  uIDEGridTooltip in 'uIDEGridTooltip.pas',
  uIDELifecycle in 'uIDELifecycle.pas',
  uIDEAddInOptionsBase in 'uIDEAddInOptionsBase.pas',
  uIDESCAOptions in 'uIDESCAOptions.pas' {SCAOptionsFrame: TFrame},
  uIDESonarOptions in 'uIDESonarOptions.pas' {SonarOptionsFrame: TFrame},
  uIDEAnalyseRunner in 'uIDEAnalyseRunner.pas';

end.
