package StaticCodeAnalyser.IDE.d12;

// ---------------------------------------------------------------------
// Paketsuffix fuer die Delphi-13-Schiene (2026-08-22)
//
// OHNE Suffix hiessen die BPLs beider IDE-Generationen gleich. Das faellt
// im Dateisystem nicht auf, weil die Bpl-Ordner versionsspezifisch sind -
// wohl aber beim Registrieren ("Known Packages") und beim Ausliefern: bis
// heute lag im 37.0-Ordner eine Datei mit d12 im Namen.
//
// BEDINGT und NICHT '{$LIBSUFFIX AUTO}': AUTO gaebe auch D12 einen Suffix,
// und daran haengen Installer, Registry-Eintraege und die
// Entwicklerinstallation. D12 baut deshalb unveraendert weiter, nur D13
// bekommt '370'.
//
// NICHT '{$IF RTLVersion >= 37}': das faellt in einer .dpk auf die Nase -
// dcc64 meldet W1023 und dann E2026 "Konstantenausdruck erwartet", weil
// RTLVersion eine Gleitkommakonstante ist. Hier gemessen, nicht vermutet.
//
// VER370 ist belegt: das mit Delphi 13 ausgelieferte Indy prueft in
// source/Indy10/System/IdCompilerDefines.inc darauf, unter der Ueberschrift
// "Delphi & CBuilder 13.0 Florence".
//
// ACHTUNG bei der naechsten Delphi-Version: {$IFDEF} trifft genau eine.
// Eine kuenftige D14 (VER380) bekaeme keinen Suffix und liefe damit gegen
// die suffixlose D12-BPL. Dann hier eine Zeile ergaenzen.
{$IFDEF VER370}
  {$LIBSUFFIX '370'}
{$ENDIF}

{$R *.res}
// Branding-Resource (sca.png als RCDATA fuer Splash + About-Box):
//   * <RcCompile Include="..\branding\sca_branding.rc"/> im .dproj triggert
//     BRCC32. RBCC32 legt das Output NEBEN die dproj/dpk (nicht neben die
//     .rc!) -> StaticCodeAnalyserIDE\sca_branding.res.
//   * {$R 'sca_branding.res'} hier linkt die .res in die BPL (sonst sieht
//     der Linker das BRCC32-Output zwar liegen, ignoriert es aber - waere
//     genau das Symptom 'IDE-Plugin-Icon nirgends sichtbar').
// WICHTIG: .RES Extension (NICHT .RC). {$R '...rc'} wuerde den 16-bit-
// Legacy-BRC ankicken (E2161 Unsupported 16bit resource).
// PFAD: relativ zur dpk (gleiches Verzeichnis), NICHT relativ zur .rc!
{$R 'sca_branding.res'}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  SCA.Engine,
  SCA.SharedUI;

contains
  uIDEExpert in 'uIDEExpert.pas',
  uIDEAnalyserForm in 'uIDEAnalyserForm.pas',
  uIDEFindingsPropertiesForm in 'uIDEFindingsPropertiesForm.pas',
  uIDELineHighlighter in 'uIDELineHighlighter.pas',
  uIDEAnnotationOverlay in 'uIDEAnnotationOverlay.pas',
  uIDEMessages in 'uIDEMessages.pas',
  uIDEWatchMode in 'uIDEWatchMode.pas',
  uIDEEditorIntegration in 'uIDEEditorIntegration.pas',
  uIDEStatusBar in 'uIDEStatusBar.pas',
  uIDETheme in 'uIDETheme.pas',
  uIDEAnalyseProgress in 'uIDEAnalyseProgress.pas',
  uIDEGridTooltip in 'uIDEGridTooltip.pas',
  uIDELifecycle in 'uIDELifecycle.pas',
  uIDEAddInOptionsBase in 'uIDEAddInOptionsBase.pas',
  uIDESCAOptions in 'uIDESCAOptions.pas' {SCAOptionsFrame: TFrame},
  uIDESonarOptions in 'uIDESonarOptions.pas' {SonarOptionsFrame: TFrame},
  uIDEAnalyseRunner in 'uIDEAnalyseRunner.pas';

end.
