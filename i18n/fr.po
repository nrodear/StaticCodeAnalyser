msgstr "Source UTF-32 - le compilateur le rejette avec l'erreur fatale F2438"

msgid "Invisible / zero-width character in source - hidden-text abuse"
msgstr "Caractère invisible / de largeur nulle dans le source - abus de texte caché"

msgid "Anonymous method inside `for i := ... do` references i - all closures see the same final value"
msgstr "Une méthode anonyme dans `for i := ... do` référence i - toutes les closures voient la même valeur finale"

msgid "Sonar-style cognitive-complexity exceeds 15 - nested if/for/while/case is hard to follow mentally"
msgstr "La complexité cognitive (style Sonar) dépasse 15 - les if/for/while/case imbriqués sont difficiles à suivre mentalement"

msgid "After T.FreeOnTerminate := True, any subsequent T.Field/T.Method access risks Access-Violation if the thread has already self-destructed"
msgstr "Après T.FreeOnTerminate := True, tout accès ultérieur à T.Field/T.Method risque une Access Violation si le thread s'est déjà auto-détruit"

msgid "File-open call (TFileStream.Create, AssignFile, ...) with a path expression that concatenates user input (Edit.Text, Request.Params, ...) - path-traversal risk"
msgstr "Ouverture de fichier (TFileStream.Create, AssignFile, ...) avec un chemin construit à partir d'une saisie utilisateur (Edit.Text, Request.Params, ...) - risque de path traversal"

msgid "[Ignore] (no string arg) skips the test silently - add a message explaining why the test is disabled"
msgstr "[Ignore] sans argument chaîne ignore le test silencieusement - ajouter un message expliquant pourquoi il est désactivé"

msgid "Two identical [X] attributes on the same member - copy-paste leftover, no effect"
msgstr "Deux attributs [X] identiques sur le même membre - reste de copier-coller, sans effet"

msgid "[Category] (no arg) is a compile-time error in DUnitX - always pass a category name"
msgstr "[Category] sans argument est une erreur de compilation dans DUnitX - toujours passer un nom de catégorie"

msgid "Class is marked [TestFixture] but contains no [Test] methods - zombie fixture visible in TestInsight but executes nothing"
msgstr "La classe est marquée [TestFixture] mais ne contient aucune méthode [Test] - fixture zombie, visible dans TestInsight mais qui n'exécute rien"

msgid "Attribute line followed by a blank line - visually loose, often a refactoring leftover"
msgstr "Ligne d'attribut suivie d'une ligne vide - visuellement détachée, souvent un reste de refactoring"

msgid "DFM component is never referenced in code, other units, or the DFM itself - possibly a refactoring leftover"
msgstr "Le composant DFM n'est référencé ni dans le code, ni dans d'autres units, ni dans le DFM lui-même - probablement un reste de refactoring"

msgid "A .pas/.dfm file lies in the project folder but is not referenced by the project (.dproj/.groupproj) - likely an orphaned / dead source file"
msgstr "Un fichier .pas/.dfm se trouve dans le dossier du projet mais n'est pas référencé par le projet (.dproj/.groupproj) - probablement un fichier source orphelin"

msgid "Non-ASCII character in identifier - homoglyph / confusable risk"
msgstr "Caractère non ASCII dans un identificateur - risque d'homoglyphe / de confusion"

msgid "not/and/or/xor bind tighter than comparisons - put the comparison in parentheses"
msgstr "not/and/or/xor sont prioritaires sur les comparaisons - mettre la comparaison entre parenthèses"

msgid "for loop runs one index past the end - the upper bound is Count - 1 or High()"
msgstr "la boucle for dépasse la fin d'un indice - la borne supérieure est Count - 1 ou High()"

msgid "Result set through the function name - write Result := instead"
msgstr "Résultat défini via le nom de la fonction - écrire Result := à la place"

msgid "The function name on the right side is a recursive call, not the current result"
msgstr "Le nom de la fonction à droite est un appel récursif, pas le résultat courant"

msgid "File not found:"
msgstr "Fichier introuvable :"

msgid "More actions (Settings, Ignore list, Branch-Changes)"
msgstr "Autres actions (paramètres, liste d'exclusions, modifications de branche)"

msgid "Done. %d findings. Click a row -> AI prompt on clipboard."
msgstr "Terminé. %d résultats. Cliquez sur une ligne -> prompt IA dans le presse-papiers."

msgid "git not found. Install Git for Windows (git-scm.com) or set the path to git.exe in analyser.ini."
msgstr "git introuvable. Installez Git for Windows (git-scm.com) ou indiquez le chemin de git.exe dans analyser.ini."

msgid "svn not found. Install TortoiseSVN WITH the option \"command line client tools\" or set the path to svn.exe in analyser.ini."
msgstr "svn introuvable. Installez TortoiseSVN AVEC l'option \"command line client tools\" ou indiquez le chemin de svn.exe dans analyser.ini."

msgid "You are a senior Delphi developer reviewing the output of a static code analyser. Target version: Delphi 12 Athens (RTL/VCL). Suggest minimal, idiomatic fixes - no sweeping refactors, no style overhauls, no new dependencies unless strictly required."
msgstr "Vous êtes un développeur Delphi expérimenté et vous relisez la sortie d'un analyseur de code statique. Version cible : Delphi 12 Athens (RTL/VCL). Proposez des corrections minimales et idiomatiques - pas de refactoring massif, pas de refonte de style, pas de nouvelle dépendance sauf nécessité absolue."

msgid "Reference pattern (generic example for this rule, NOT the user's code)"
msgstr "Motif de référence (exemple générique pour cette règle, PAS le code de l'utilisateur)"

msgid "Editor right-click triggers a single-file analysis; findings appear as stripes + hover overlays in the editor (no dock)."
msgstr "Un clic droit dans l'éditeur lance l'analyse d'un seul fichier ; les résultats apparaissent sous forme de marques et d'infobulles dans l'éditeur (sans fenêtre ancrée)."

msgid "UsesCheck - report unused entries in uses clause (may produce false positives)"
msgstr "UsesCheck - signaler les entrées inutilisées de la clause uses (peut produire des faux positifs)"

msgid "AutoDiscoverClasses - extend LeakyClasses with project-specific classes"
msgstr "AutoDiscoverClasses - étendre LeakyClasses avec des classes spécifiques au projet"

