# ---- VCS / Branch-Changes messages ----------------------------------------
msgid "no Git/SVN repository in or above %s"
msgstr "aucun dépôt Git/SVN dans ou au-dessus de %s"

msgid "no base branch (main/master) found - working tree only"
msgstr "aucune branche de base (main/master) trouvée - copie de travail uniquement"

msgid "git not found. Install Git for Windows."
msgstr "git introuvable. Installez Git pour Windows."

msgid "svn not found. Install TortoiseSVN with command line tools."
msgstr "svn introuvable. Installez TortoiseSVN avec les outils en ligne de commande."

# ---- Quality-Score / Notenskala --------------------------------------------
msgid "No findings - clean baseline"
msgstr "Aucun résultat - base saine"

msgid "Clean - minor smells only"
msgstr "Propre - seulement des smells mineurs"

msgid "Visible tech debt, no critical bugs"
msgstr "Dette technique visible, aucun bug critique"

msgid "Multiple errors/vulnerabilities - refactor advised"
msgstr "Plusieurs erreurs/vulnérabilités - refactoring conseillé"

msgid "Refactor needed - many critical findings"
msgstr "Refactoring nécessaire - nombreux résultats critiques"

msgid "Raw score: %d"
msgstr "Score brut : %d"

msgid "Errors: %d, Warnings: %d, Hints: %d"
msgstr "Erreurs : %d, Avertissements : %d, Conseils : %d"

msgid "Vulnerabilities: %d, Hotspots: %d, File errors: %d"
msgstr "Vulnérabilités : %d, Hotspots : %d, Erreurs de fichier : %d"

msgid "Grade scale: A=0, B<=%d, C<=%d, D<=%d, E>%d"
msgstr "Échelle de notes : A=0, B<=%d, C<=%d, D<=%d, E>%d"

msgid "Weights: Vuln 10, Error 7, Hotspot 5, Warning 3, Hint 1, FileErr 2"
msgstr "Poids : Vuln 10, Error 7, Hotspot 5, Warning 3, Hint 1, FileErr 2"

msgid "Click: reset filters (show everything)"
msgstr "Clic : réinitialiser les filtres (tout afficher)"

# ---- Detektor-Kurzbeschreibungen -------------------------------------------
msgid "// NOSONAR suppression marker found - audit it"
msgstr "Marqueur de suppression // NOSONAR trouvé - à vérifier"

msgid "A single method handles too many component events - split it up"
msgstr "Une seule méthode gère trop d'événements de composants - la scinder"

msgid "Assert() without explanatory message"
msgstr "Assert() sans message explicatif"

msgid "Assigned(X) and (X <> nil) - one check is enough"
msgstr "Assigned(X) and (X <> nil) - une seule vérification suffit"

msgid "Asymmetric begin/end in if/else - format consistently"
msgstr "begin/end asymétriques dans if/else - formater de manière cohérente"

msgid "Binary expression has identical left and right side - copy-paste bug?"
msgstr "Expression binaire dont les deux côtés sont identiques - erreur de copier-coller ?"

msgid "Boolean compared to True/False - redundant"
msgstr "Booléen comparé à True/False - redondant"

msgid "Branch body without begin..end - add explicit block"
msgstr "Corps de branche sans begin..end - ajouter un bloc explicite"

msgid "Class field without \"F\" prefix"
msgstr "Champ de classe sans préfixe \"F\""

msgid "Class/record type without \"T\" prefix"
msgstr "Type class/record sans préfixe \"T\""

msgid "Comment contains Pascal-code markers - delete it or restore it"
msgstr "Le commentaire contient du code Pascal - le supprimer ou le réactiver"

msgid "Component class is on the project-defined forbidden list"
msgstr "La classe de composant figure sur la liste interdite définie par le projet"

msgid "Component event is wired but the handler body is empty"
msgstr "L'événement du composant est relié mais le corps du gestionnaire est vide"

msgid "Component has both Action and OnClick - the OnClick handler is dead code"
msgstr "Le composant a à la fois Action et OnClick - le gestionnaire OnClick est du code mort"

msgid "Component uses the IDE default name - rename for clarity"
msgstr "Le composant utilise le nom par défaut de l'IDE - renommer pour plus de clarté"

msgid "Constructor does not call inherited - parent state uninitialized"
msgstr "Le constructeur n'appelle pas inherited - l'état de la classe parente n'est pas initialisé"

msgid "Create without try/finally - exception path leaks the object"
msgstr "Create sans try/finally - le chemin d'exception laisse fuir l'objet"

msgid "Custom rule defined in analyser-rules.yml matched this code"
msgstr "Une règle personnalisée définie dans analyser-rules.yml correspond à ce code"

msgid "Cyclomatic complexity too high - too many branches; extract methods or simplify conditions"
msgstr "Complexité cyclomatique trop élevée - trop de branches ; extraire des méthodes ou simplifier les conditions"

msgid "DB-control class does not fit the field data type"
msgstr "La classe du contrôle DB ne correspond pas au type de données du champ"

msgid "DFM declares a component but the form class has no published field for it"
msgstr "Le DFM déclare un composant mais la classe de la fiche n'a aucun champ published correspondant"

msgid "Database component sits on a Form/Frame - move to a TDataModule"
msgstr "Composant base de données placé sur une Form/Frame - le déplacer dans un TDataModule"

msgid "Database credentials sit in the form file - move them out"
msgstr "Les identifiants de base de données sont dans le fichier de fiche - les externaliser"

msgid "Dead code: statements after Exit / raise are unreachable"
msgstr "Code mort : les instructions après Exit / raise sont inatteignables"

msgid "Debug output left in production code"
msgstr "Sortie de débogage laissée dans le code de production"

msgid "Destructor does not call inherited - resource leak"
msgstr "Le destructeur n'appelle pas inherited - fuite de ressources"

msgid "Division by zero: EZeroDivide or EDivByZero possible"
msgstr "Division par zéro : EZeroDivide ou EDivByZero possible"

msgid "Double semicolon \";;\" - one is enough"
msgstr "Point-virgule doublé \";;\" - un seul suffit"

msgid "Doubled parentheses around a simple expression"
msgstr "Parenthèses doublées autour d'une expression simple"

msgid "Empty argument list \"()\" - drop the parentheses"
msgstr "Liste d'arguments vide \"()\" - supprimer les parenthèses"

msgid "Empty begin..end block"
msgstr "Bloc begin..end vide"

msgid "Empty except block silently swallows every exception"
msgstr "Un bloc except vide avale silencieusement toutes les exceptions"

msgid "Empty finally block - either drop the try or add cleanup"
msgstr "Bloc finally vide - supprimer le try ou ajouter le nettoyage"

msgid "Empty visibility section in class - delete it"
msgstr "Section de visibilité vide dans la classe - la supprimer"

msgid "Event handler in DFM points to a method that no longer exists"
msgstr "Le gestionnaire d'événement du DFM pointe vers une méthode qui n'existe plus"

msgid "Exception class without E-prefix"
msgstr "Classe d'exception sans préfixe E"

msgid "Exit/Continue directly before end - redundant"
msgstr "Exit/Continue juste avant end - redondant"

msgid "FieldByName in loop - cache the TField reference outside"
msgstr "FieldByName dans une boucle - mettre en cache la référence TField à l'extérieur"

msgid "File could not be read or parsed"
msgstr "Le fichier n'a pas pu être lu ou analysé"

msgid "Float format spec without TFormatSettings - locale-dependent decimal separator"
msgstr "Format flottant sans TFormatSettings - séparateur décimal dépendant de la locale"

msgid "Format() placeholder count does not match argument count"
msgstr "Le nombre d'espaces réservés de Format() ne correspond pas au nombre d'arguments"

msgid "Free is outside the protecting finally block"
msgstr "Free se trouve en dehors du bloc finally protecteur"

msgid "Function return value is not freed by the caller"
msgstr "La valeur de retour de la fonction n'est pas libérée par l'appelant"

msgid "Grouped variable/field declaration - one per line"
msgstr "Déclaration groupée de variables/champs - une par ligne"

msgid "Hardcoded path - load it from configuration instead"
msgstr "Chemin en dur - le charger depuis la configuration"

msgid "Input control sits directly on the form - wrap it in a panel"
msgstr "Le contrôle de saisie est directement sur la fiche - l'englober dans un panneau"

msgid "Interface declaration has no methods"
msgstr "La déclaration d'interface ne contient aucune méthode"

msgid "Interface type without \"I\" prefix"
msgstr "Type interface sans préfixe \"I\""

msgid "Large integer literal without digit grouping"
msgstr "Grand littéral entier sans séparateur de milliers"

msgid "Length()/.Count minus a constant can underflow on empty input"
msgstr "Length() / .Count moins une constante peut passer sous zéro si l'entrée est vide"

msgid "Line ends with whitespace - diff hygiene"
msgstr "La ligne se termine par des espaces - hygiène des diffs"

msgid "Local constant should be UPPER_SNAKE_CASE"
msgstr "Une constante locale devrait être en UPPER_SNAKE_CASE"

msgid "Local variable declared but never read or written"
msgstr "Variable locale déclarée mais jamais lue ni écrite"

msgid "Lock acquired without try..finally release - exception leaves the lock held"
msgstr "Lock acquis sans libération dans try..finally - une exception laisse le lock verrouillé"

msgid "Long string concatenation - prefer Format() for readability"
msgstr "Longue concaténation de chaînes - préférer Format() pour la lisibilité"

msgid "Magic number - replace literal with a named constant"
msgstr "Nombre magique - remplacer le littéral par une constante nommée"

msgid "Many DB components on one form - extract into a TDataModule"
msgstr "Beaucoup de composants DB sur une seule fiche - les extraire dans un TDataModule"

msgid "Master-detail wiring forms a cycle - opening the dataset will loop endlessly"
msgstr "Le câblage maître-détail forme un cycle - l'ouverture du dataset bouclera indéfiniment"

msgid "MasterSource set without MasterFields/IndexFieldNames - silent cross-join"
msgstr "MasterSource défini sans MasterFields/IndexFieldNames - produit croisé silencieux"

msgid "Method body is empty - forgotten stub or unintentional?"
msgstr "Le corps de la méthode est vide - ébauche oubliée ou involontaire ?"

msgid "Method calls inherited more than once"
msgstr "La méthode appelle inherited plusieurs fois"

msgid "Method name not in PascalCase"
msgstr "Nom de méthode qui n'est pas en PascalCase"

msgid "Method too long - splitting it improves readability and testability"
msgstr "Méthode trop longue - la scinder améliore la lisibilité et la testabilité"

msgid "Multiple class declarations in one unit"
msgstr "Plusieurs déclarations de classes dans une même unit"

msgid "Multiple components bind the same DataSource and DataField"
msgstr "Plusieurs composants sont liés au même DataSource et DataField"

msgid "Multiple identical code blocks - extract a method (DRY)"
msgstr "Plusieurs blocs de code identiques - extraire une méthode (DRY)"

msgid "Nested procedure/function - consider extracting"
msgstr "procedure/function imbriquée - envisager de l'extraire"

msgid "Nested try block - consider extracting a procedure"
msgstr "Bloc try imbriqué - envisager d'extraire une procédure"

msgid "Nesting too deep - use early exit (guard clauses) or extract a method"
msgstr "Imbrication trop profonde - utiliser des sorties anticipées (guard clauses) ou extraire une méthode"

msgid "Nil dereference: access through a possibly nil reference"
msgstr "Déréférencement nil : accès via une référence potentiellement nil"

msgid "Object created but never freed (memory leak)"
msgstr "Objet créé mais jamais libéré (fuite mémoire)"

msgid "Open marker (TODO / FIXME / HACK / XXX) - resolve before release"
msgstr "Marqueur ouvert (TODO / FIXME / HACK / XXX) - à traiter avant la livraison"

msgid "ParamByName in loop - cache the TParam reference outside"
msgstr "ParamByName dans une boucle - mettre en cache la référence TParam à l'extérieur"

msgid "Parameter never read in method body"
msgstr "Paramètre jamais lu dans le corps de la méthode"

msgid "Pascal keyword not in lowercase"
msgstr "Mot-clé Pascal qui n'est pas en minuscules"

msgid "Password / token literal in source code"
msgstr "Mot de passe / token en littéral dans le code source"

msgid "Plaintext HTTP URL - prefer https:// for remote endpoints"
msgstr "URL HTTP en clair - préférer https:// pour les points de terminaison distants"

msgid "Pointer type alias should start with \"P\""
msgstr "Un alias de type pointeur devrait commencer par \"P\""

msgid "Public field - expose a property instead"
msgstr "Champ public - exposer plutôt une property"

msgid "Public member has no callers anywhere - dead API"
msgstr "Ce membre public n'est appelé nulle part - API morte"

msgid "Public member is referenced only within the current unit - Delphi-classic `private` (unit-scope) suffices"
msgstr "Ce membre public n'est référencé que dans l'unit courante - le `private` classique de Delphi (portée unit) suffit"

msgid "Public member is used only by methods of its own class - `strict private` reaches the strongest encapsulation"
msgstr "Ce membre public n'est utilisé que par les méthodes de sa propre classe - `strict private` offre l'encapsulation la plus forte"

msgid "Public member is used only by subclasses - protected is tighter"
msgstr "Ce membre public n'est utilisé que par les sous-classes - protected est plus restrictif"

msgid "Public member missing doc comment"
msgstr "Membre public sans commentaire de documentation"

msgid "Published method looks like an event handler but no component binds it"
msgstr "Cette méthode published ressemble à un gestionnaire d'événement mais aucun composant ne l'utilise"

msgid "Required dataset field has no DB-control binding it"
msgstr "Ce champ obligatoire du dataset n'est lié à aucun contrôle DB"

msgid "Required field is bound only to invisible controls"
msgstr "Ce champ obligatoire n'est lié qu'à des contrôles invisibles"

msgid "SQL command built with \"+\" - SQL injection risk"
msgstr "Commande SQL construite avec \"+\" - risque d'injection SQL"

msgid "SQL query is built from a UI input field - parameterize instead of concatenating"
msgstr "La requête SQL est construite à partir d'un champ de saisie - utiliser des paramètres au lieu de concaténer"

msgid "Self-assignment is a no-op - usually a copy-paste mistake"
msgstr "Une auto-affectation ne fait rien - généralement une erreur de copier-coller"

msgid "Source line exceeds 120 characters - wrap or extract"
msgstr "La ligne dépasse 120 caractères - la couper ou extraire une sous-expression"

msgid "String concatenation in loop - quadratic reallocations"
msgstr "Concaténation de chaînes dans une boucle - réallocations quadratiques"

msgid "String literal repeated - extract to a constant or resourcestring"
msgstr "Littéral chaîne répété - l'extraire dans une constante ou une resourcestring"

msgid "Synchronize() in a destructor - worker and UI thread deadlock each other"
msgstr "Synchronize() dans un destructeur - le thread de travail et le thread UI se bloquent mutuellement"

msgid "TLS verification disabled - MITM-attack surface"
msgstr "Vérification TLS désactivée - surface d'attaque MITM"

msgid "TThread destroyed without Terminate+WaitFor - worker may still be running"
msgstr "TThread détruit sans Terminate+WaitFor - le worker tourne peut-être encore"

msgid "TThread.Resume is deprecated - use TThread.Start (since Delphi 2010)"
msgstr "TThread.Resume est deprecated - utiliser TThread.Start (depuis Delphi 2010)"

msgid "Tab character in source - use spaces for indentation"
msgstr "Caractère de tabulation dans le source - indenter avec des espaces"

msgid "Too many parameters - introduce a parameter object / record"
msgstr "Trop de paramètres - introduire un objet / record de paramètres"

msgid "Trailing comma in argument list"
msgstr "Virgule finale dans la liste d'arguments"

msgid "Two consecutive const/type/var sections - merge them"
msgstr "Deux sections const/type/var consécutives - les fusionner"

msgid "Two sibling controls share the same TabOrder - tab navigation is undefined"
msgstr "Deux contrôles voisins partagent le même TabOrder - l'ordre de tabulation est indéfini"

msgid "Two visibility sections with the same keyword - merge them"
msgstr "Deux sections de visibilité avec le même mot-clé - les fusionner"

msgid "UI text in DFM is a literal string - route it through the localization layer"
msgstr "Le texte d'interface dans le DFM est un littéral - le faire passer par la couche de localisation"

msgid "UPDATE/DELETE/TRUNCATE without WHERE - affects ALL rows"
msgstr "UPDATE/DELETE/TRUNCATE sans WHERE - affecte TOUTES les lignes"

msgid "Unit ends with begin..end. - use initialization section"
msgstr "L'unit se termine par begin..end. - utiliser une section initialization"

msgid "Unit has no declarations - delete it or fill it"
msgstr "Unit sans aucune déclaration - la supprimer ou la remplir"

msgid "Unit-level keyword not at column 1"
msgstr "Mot-clé de section d'unit qui n'est pas en colonne 1"

msgid "Uses entry may be unused - remove to reduce coupling"
msgstr "Entrée uses peut-être inutilisée - la retirer réduit le couplage"

msgid "Virtual method called from constructor - override sees half-initialized Self"
msgstr "Méthode virtuelle appelée depuis le constructeur - la redéfinition voit un Self à moitié initialisé"

msgid "X.Free; X := nil; -> use FreeAndNil(X)"
msgstr "X.Free; X := nil; -> utiliser FreeAndNil(X)"

msgid "asm..end block - platform-specific, hard to port"
msgstr "Bloc asm..end - spécifique à la plate-forme, difficile à porter"

msgid "case statement has many branches - consider dispatch table"
msgstr "Instruction case avec de nombreuses branches - envisager une table de dispatch"

msgid "class(TObject) - TObject is the default base, drop it"
msgstr "class(TObject) - TObject est la classe de base par défaut, redondant"

msgid "for-loop range is reversed - the loop body never runs"
msgstr "La plage de la boucle for est inversée - le corps ne s'exécute jamais"

msgid "goto weakens structured control flow"
msgstr "goto affaiblit le flux de contrôle structuré"

msgid "if X then Y := True else Y := False - assign expression directly"
msgstr "if X then Y := True else Y := False - affecter directement l'expression"

msgid "on E: Exception catches everything - too broad"
msgstr "on E: Exception intercepte tout - trop large"

msgid "out parameter - prefer Result or var"
msgstr "Paramètre out - préférer Result ou var"

msgid "with statement can silently rebind identifiers - avoid it"
msgstr "L'instruction with peut redéfinir silencieusement des identificateurs - à éviter"

msgid "Exception is constructed but never raised"
msgstr "L'exception est construite mais jamais levée"

msgid "Function never assigns Result - return value undefined"
msgstr "La fonction n'affecte jamais Result - valeur de retour indéfinie"

msgid "Re-raise of bound variable loses the original stack trace"
msgstr "Relancer l'exception via la variable liée perd la pile d'appels d'origine"

msgid "Type-cast before Free / Destroy has no effect (Destroy is virtual)"
msgstr "Un transtypage avant Free / Destroy est sans effet (Destroy est virtual)"

msgid "Constructor invoked on instance - no allocation, fields re-initialised over live data"
msgstr "Constructeur appelé sur une instance - aucune allocation, les champs sont réinitialisés par-dessus des données vivantes"

msgid "Override whose body is just \"inherited\" adds nothing"
msgstr "Une redéfinition dont le corps se limite à \"inherited\" n'apporte rien"

msgid "Prefer Assigned() over \"= nil\" / \"<> nil\""
msgstr "Préférer Assigned() à \"= nil\" / \"<> nil\""

msgid "Raise a specific exception class, not the base Exception"
msgstr "Lever une classe d'exception spécifique, pas la classe de base Exception"

msgid "Locale-dependent conversion without explicit TFormatSettings"
msgstr "Conversion dépendante de la locale sans TFormatSettings explicite"

msgid "8-bit string cast silently drops non-codepage characters"
msgstr "Un transtypage vers une chaîne 8 bits supprime silencieusement les caractères hors de la page de codes"

msgid "PChar(Char) reinterprets the codepoint as a pointer - undefined behaviour"
msgstr "PChar(Char) réinterprète le point de code comme un pointeur - comportement indéfini"

msgid "IfThen() evaluates both branches - no short-circuit semantics"
msgstr "IfThen() évalue les deux branches - pas d'évaluation en court-circuit"

