msgid "Float equality is unreliable due to IEEE-754 rounding - use SameValue/Math.IsZero"
msgstr "L'égalité de flottants n'est pas fiable à cause des arrondis IEEE-754 - utiliser SameValue/Math.IsZero"

msgid "Raise inside destructor without try/except - cleanup is aborted"
msgstr "raise dans un destructeur sans try/except - le nettoyage est interrompu"

msgid "Boolean parameter drives internal branching - consider two methods with descriptive names"
msgstr "Un paramètre booléen pilote le branchement interne - envisager deux méthodes aux noms explicites"

msgid "Unused private method"
msgstr "Méthode privée inutilisée"

msgid "Could be class method"
msgstr "Pourrait être une méthode de classe"

msgid "Missing override"
