// Kuerzel aller eingebetteten .po, in Dateisystem-Sortierung. Quelle
// fuer uLocalization.AvailableLanguages - damit die Sprachauswahl in
// der UI aus den tatsaechlich vorhandenen Uebersetzungen kommt und
// nicht aus einer von Hand gepflegten Liste (die zwangslaeufig driftet).
function EmbeddedLanguages: TArray<string>;
begin
  Result := TArray<string>.Create('de', 'en', 'fr');
end;

// Liefert den eingebetteten .po-Text zu einem normalisierten Sprach-
// kuerzel, oder '' wenn zu der Sprache nichts eingebettet ist.
function EmbeddedPoText(const ALang: string): string;
begin
  if SameText(ALang, 'de') then
    Result := JoinPoLines(CPoLines_de)
  else if SameText(ALang, 'en') then
    Result := JoinPoLines(CPoLines_en)
  else if SameText(ALang, 'fr') then
    Result := JoinPoLines(CPoLines_fr)
  else
    Result := '';
end;

