package SCA.SharedUI;

// ---------------------------------------------------------------------
// Paketsuffix und Pakettyp (2026-08-23)
//
// {$LIBSUFFIX AUTO} setzt die Paketversion der bauenden IDE ein:
// 290 unter Delphi 12, 370 unter Delphi 13. Damit traegt EIN
// Projektsatz beide Generationen - es gibt keinen zweiten
// Dateisatz, keinen Namensunterschied zwischen .dproj und .dpk und
// keine Fallunterscheidung im Quelltext.
// Die .dproj spiegelt das mit <DllSuffix>$(Auto)</DllSuffix>; nur
// dann erwartet die IDE denselben Namen, den der Compiler schreibt.
//
// Laufzeitpaket: wird vom IDE-Paket ueber requires geladen.
// Ohne {$RUNONLY} bzw. {$DESIGNONLY} haelt die IDE ein Paket fuer
// BEIDES und installiert es nach jedem Bau in sich selbst. Die
// Angabe in der .dproj allein reicht nicht - am 2026-08-23
// gemessen. So machen es auch JCL und die GetIt-Plugins.
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  vclwinx,
  // designide stand hier ohne Grund: keine der Units dieses Pakets
  // benutzt eine designide-Unit (2026-08-23 geprueft, alle
  // ToolsAPI-Erwaehnungen sind Kommentare, die das ausdruecklich
  // ausschliessen). Die Zeile machte SCA.SharedUI zum Mischling aus
  // Laufzeit- und Entwurfszeitpaket und verhinderte jeden
  // Win64-Bau - designide gibt es unter D12 nur fuer Win32.
  SCA.Engine;

contains
  uAnalyserPalette in 'sources\uAnalyserPalette.pas',
  uAnalyserTheme in 'sources\uAnalyserTheme.pas',
  uAppTheme in 'sources\uAppTheme.pas',
  uFindingGridRenderer in 'sources\uFindingGridRenderer.pas',
  uFindingsPropertiesFrame in 'sources\uFindingsPropertiesFrame.pas',
  uFindingFilter in 'sources\uFindingFilter.pas',
  uFuzzyComboSearch in 'sources\uFuzzyComboSearch.pas',
  uHintTextLayout in 'sources\uHintTextLayout.pas',
  uIDEStatsTiles in 'sources\uIDEStatsTiles.pas',
  uIDEHelpPanel in 'sources\uIDEHelpPanel.pas',
  uIDEToolbar in 'sources\uIDEToolbar.pas',
  uExportMenu in 'sources\uExportMenu.pas',
  uIDEColors in 'sources\uIDEColors.pas',
  uUiElementRegistry in 'sources\uUiElementRegistry.pas',
  uPathNormalize in 'sources\uPathNormalize.pas',
  uRecentPaths in 'sources\uRecentPaths.pas',
  uScanTargetDialog in 'sources\uScanTargetDialog.pas';

end.
