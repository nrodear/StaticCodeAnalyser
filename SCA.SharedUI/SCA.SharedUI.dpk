package SCA.SharedUI;

// ---------------------------------------------------------------------
// Pakettyp (2026-08-23): Laufzeitpaket: wird vom Plugin ueber requires geladen, registriert nichts.
//
// Ohne {$RUNONLY} bzw. {$DESIGNONLY} haelt die IDE ein Paket fuer
// BEIDES und installiert es nach jedem Bau in sich selbst. Genau
// daran ist Delphi 13 heute gescheitert: SCA.Engine und
// SCA.SharedUI standen aus einem IDE-Bau in den Known Packages,
// der Monolith kam per Setup daneben, und die IDE meldete
// "enthaelt die Unit 'uLocalization', die auch im Package
// 'SCA.Engine' enthalten ist".
//
// Die Angabe in der .dproj (<RuntimeOnlyPackage>) reicht NICHT -
// sie ist nur der MSBuild-Spiegel. Massgeblich ist diese
// Direktive. So machen es auch JCL und die GetIt-Plugins.
{$RUNONLY}
{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  SCA.Engine;

contains
  uAnalyserPalette in 'sources\uAnalyserPalette.pas',
  uAnalyserTheme in 'sources\uAnalyserTheme.pas',
  uAppTheme in 'sources\uAppTheme.pas',
  uFindingGridRenderer in 'sources\uFindingGridRenderer.pas',
  uFindingsPropertiesFrame in 'sources\uFindingsPropertiesFrame.pas',
  uFindingFilter in 'sources\uFindingFilter.pas',
  uFuzzyComboSearch in 'sources\uFuzzyComboSearch.pas',
  uHintTextLayout in 'sources\uHintTextLayout.pas',
  uIDEStatsTiles in 'sources\uIDEStatsTiles.pas',
  uIDEHelpPanel in 'sources\uIDEHelpPanel.pas',
  uIDEToolbar in 'sources\uIDEToolbar.pas',
  uExportMenu in 'sources\uExportMenu.pas',
  uIDEColors in 'sources\uIDEColors.pas',
  uUiElementRegistry in 'sources\uUiElementRegistry.pas',
  uPathNormalize in 'sources\uPathNormalize.pas',
  uRecentPaths in 'sources\uRecentPaths.pas',
  uScanTargetDialog in 'sources\uScanTargetDialog.pas';

end.
